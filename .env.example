# Copia este archivo a .env.local. .env.local está en .gitignore.
# Los valores de base de datos y almacenamiento coinciden con docker-compose.yml.

# --- Base de datos (Postgres en Docker) -------------------------------------
DATABASE_URL=postgres://breadboard:breadboard@localhost:54322/breadboard

# --- Autenticación ----------------------------------------------------------
# Firma las cookies de sesión. Genera una propia:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# --- Almacenamiento de objetos (S3-compatible en Docker) --------------------
S3_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=breadboard
S3_SECRET_ACCESS_KEY=breadboard-secret
S3_BUCKET_DOCUMENTS=documents
S3_BUCKET_VIDEOS=videos
S3_FORCE_PATH_STYLE=true

# --- Claude -----------------------------------------------------------------
# Clave de https://console.anthropic.com
ANTHROPIC_API_KEY=

# De dónde sale el guion:
#   auto   -> Claude si hay clave, plantilla de ejemplo si no (por defecto)
#   claude -> siempre Claude; falla si no hay clave
#   mock   -> siempre la plantilla, para probar sin gastar
STORYBOARD_PROVIDER=auto

# --- Voz (ElevenLabs) -------------------------------------------------------
# Clave de https://elevenlabs.io — Profile > API Keys.
# Sin ella los videos se generan mudos y con un aviso; ponerla es lo único que
# hace falta para que hablen.
ELEVENLABS_API_KEY=

# Modelo. Turbo v2.5 cuesta la mitad que multilingual ($0.05 vs $0.10 por cada
# mil caracteres) y habla al mismo ritmo. Si la voz no te convence, prueba
# eleven_multilingual_v2 — el doble de precio.
#   eleven_turbo_v2_5 | eleven_flash_v2_5 | eleven_multilingual_v2
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# Fija una voz concreta. Vacío = se elige una de tu cuenta según el idioma.
# Para ver las que tienes: npm run voices
ELEVENLABS_VOICE_ID=
