# Copia este archivo a .env.local. .env.local está en .gitignore.
# Los valores de base de datos y almacenamiento coinciden con docker-compose.yml.

# --- Base de datos (Postgres en Docker) -------------------------------------
DATABASE_URL=postgres://breadboard:breadboard@localhost:54322/breadboard

# --- Autenticación ----------------------------------------------------------
# Firma las cookies de sesión. Genera una propia:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# --- Almacenamiento de objetos (S3-compatible en Docker) --------------------
S3_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=breadboard
S3_SECRET_ACCESS_KEY=breadboard-secret
S3_BUCKET_DOCUMENTS=documents
S3_BUCKET_VIDEOS=videos
S3_FORCE_PATH_STYLE=true

# --- Claude -----------------------------------------------------------------
# Clave de https://console.anthropic.com
ANTHROPIC_API_KEY=

# De dónde sale el guion:
#   auto   -> Claude si hay clave, plantilla de ejemplo si no (por defecto)
#   claude -> siempre Claude; falla si no hay clave
#   mock   -> siempre la plantilla, para probar sin gastar
STORYBOARD_PROVIDER=auto
